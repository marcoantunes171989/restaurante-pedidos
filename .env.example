# Supabase — copie este arquivo para .env e preencha com as credenciais do projeto
# Dashboard: https://supabase.com/dashboard/project/SEU_REF/settings/api

VITE_SUPABASE_URL=https://SEU_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Somente no servidor (Vercel → Environment Variables). NUNCA no front / VITE_*.
# Obrigatória para /api/gerenciar-usuario-auth e /api/login-banco
# (cadastro + login validando tab_usuarios e alinhando o Auth).
# Production e Preview → Redeploy após definir.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Opcional no servidor se VITE_SUPABASE_ANON_KEY já estiver na Vercel:
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
